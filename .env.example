# ── Sign-in ──────────────────────────────────────────────────────────────
# The password people type on the web app's sign-in page.
ADMIN_PASSWORD=choose-a-long-password
# Shared secret for server-to-server calls (the AIM billing app's x-api-key).
# Must equal the app's WHATSAPP_SERVICE_API_KEY.
API_KEY=a-long-random-secret-shared-with-the-AIM-app-only

# ── The web app (Vercel) ────────────────────────────────────────────────
# Sites allowed to call this API, comma-separated. One leading * is allowed
# for Vercel preview deployments: https://*.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# ── Where clients, campaigns and chats are stored ───────────────────────
#   local      JSON files in DATA_DIR — for testing on your computer.
#   firestore  Firebase — use this on Render (its free disk is wiped on
#              every deploy and restart).
DATA_STORE=local
DATA_DIR=./data

# ── Firebase ─────────────────────────────────────────────────────────────
# Always needed for the WhatsApp login session (so a restart does not need a
# new QR scan), and for data when DATA_STORE=firestore.
# Locally, point at the downloaded key file:
FIREBASE_SERVICE_ACCOUNT_PATH=./starlinkjewels109-firebase-adminsdk-fbsvc-2a1fa3a004.json
# On a host, paste the whole key file as ONE line instead:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...",...}
# The named Firestore database. Must belong to the same project as the key.
FIRESTORE_DATABASE_ID=starlinkbilling

# Which saved WhatsApp session to use. Give a test computer its own id
# (e.g. laptop-test) so it never takes over the live one — see README.
WA_SESSION_ID=default

# 1 = pretend WhatsApp + sample clients. Nothing is really sent.
DEMO_MODE=0
